{
  "name": "kiosk_js",
  "version": "1.0.0",
  "description": "Express + Sequelize(MySQL) 기반 카페 키오스크 백엔드 API",
  "main": "app.js",
  "scripts": {
    "start": "node app.js",
    "dev": "nodemon app.js",
    "db:create": "sequelize db:create",
    "db:migrate": "sequelize db:migrate",
    "db:migrate:undo": "sequelize db:migrate:undo:all"
  },
